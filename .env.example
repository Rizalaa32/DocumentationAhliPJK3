# Port aplikasi internal Node.js (diteruskan oleh Nginx dari port 80/443)
PORT=3000
NODE_ENV=production

# Kunci Akses Tim (Kosongkan saat development lokal jika tidak ingin dikunci)
# Di server produksi, isi dengan kode acak panjang, contoh: TimPJK3_Riksa2026_X9kL2p
# Lalu bagikan link: https://domain-anda.com/?key=TimPJK3_Riksa2026_X9kL2p
ACCESS_KEY=

# Batasi CORS ke domain resmi Anda di produksi (contoh: https://riksa.domainanda.com)
ALLOWED_ORIGIN=*

# Opsional: isi jika ingin memakai Chromium sistem Linux, kosongkan untuk memakai bawaan Puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

